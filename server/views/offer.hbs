<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{title}} · I-CCMS</title>
<style>
  :root { --bg:#F4F8FA; --surface:#FFFFFF; --text:#0F1C24; --muted:#55666F; --line:#D0DCE3; --primary:#0B4F6C;
          --safe:#15803D; --critical:#B91C1C; --on-primary:#FFFFFF; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#0A141A; --surface:#111E26; --text:#E6F1F5; --muted:#93A8B3; --line:#24404D; --primary:#4FC3E8;
            --safe:#4ADE80; --critical:#F87171; --on-primary:#0A141A; }
  }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--text); font:17px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 560px; margin: 0 auto; padding: 16px; }
  .brand { font-weight:700; color:var(--primary); margin-bottom:12px; }
  .card { background:var(--surface); border:1px solid var(--line); border-radius:12px; padding:16px; margin-bottom:12px; }
  h1 { font-size:22px; margin:0 0 8px; }
  .muted { color:var(--muted); font-size:15px; }
  dl { display:grid; grid-template-columns: max-content 1fr; gap:8px 16px; margin:12px 0 0; }
  dt { color:var(--muted); font-size:15px; } dd { margin:0; font-weight:600; }
  .actions { display:flex; gap:12px; margin-top:16px; }
  .actions form { flex:1; margin:0; }
  button { width:100%; min-height:56px; border-radius:10px; font:inherit; font-weight:700; cursor:pointer; border:2px solid transparent; }
  .accept { background:var(--safe); color:var(--on-primary); }
  .reject { background:transparent; color:var(--critical); border-color:var(--critical); }
  .done { font-size:18px; }
</style>
</head>
<body>
<main>
  <div class="brand">I-CCMS</div>
  <div class="card">
    <h1>{{title}}</h1>
    {{#if open}}
      <p class="muted">A refrigerated truck can bring this cargo to <strong>{{offer.buyer}}</strong> now. Answer before <strong>{{offer.expiresAt}}</strong>.</p>
      <dl>
        <dt>Product</dt><dd>{{offer.products}}</dd>
        <dt>Quantity</dt><dd>{{offer.quantityKg}} kg ({{offer.batches}} {{offer.batchWord}})</dd>
        <dt>Grade</dt><dd>{{offer.grades}}</dd>
        <dt>Discount</dt><dd>{{offer.discountPct}} %</dd>
        {{#if offer.shelfLifeH}}<dt>Shelf life left</dt><dd>about {{offer.shelfLifeH}} h</dd>{{/if}}
        <dt>Trip</dt><dd>{{offer.trip}}</dd>
      </dl>
      <div class="actions">
        <form method="post" action="/offer/{{offer.token}}/accept"><button class="accept" type="submit">Accept</button></form>
        <form method="post" action="/offer/{{offer.token}}/reject"><button class="reject" type="submit">Reject</button></form>
      </div>
    {{else}}
      <p class="done">{{message}}</p>
    {{/if}}
  </div>
  <p class="muted">This link works once. Do not forward it.</p>
</main>
</body>
</html>
