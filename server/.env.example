# Copy to .env for local dev. Production values come from SSM (Section 17).
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=debug
DATABASE_URL=postgresql://iccms:iccms_dev@127.0.0.1:5433/iccms
ML_SERVICE_URL=http://127.0.0.1:8000
ML_INTERNAL_TOKEN=dev-internal-token
SMS_PROVIDER=console

# Supabase (D-21). Publishable values are fine here; the service role key is a secret (.env only).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SEND_SMS_HOOK_SECRET=
HTTPSMS_WEBHOOK_SECRET=

# Trace URL signing (SYN-09). Any random string of 32+ chars; must stay stable or old QR labels break.
TRACE_SIGNING_KEY=dev-trace-signing-key-change-me-0123456789

# Uploads (D-07). Leave S3_BUCKET empty to disable uploads in dev; S3_ENDPOINT only for MinIO/localstack.
AWS_REGION=ap-south-1
S3_BUCKET=
S3_ENDPOINT=

# Telemetry pipeline (M8) — matches deploy/docker-compose.dev.yml
REDIS_URL=redis://127.0.0.1:6379
KAFKA_BROKERS=127.0.0.1:29092
INFLUX_URL=http://127.0.0.1:8086
INFLUX_TOKEN=dev-influx-token
INFLUX_ORG=iccms
INFLUX_BUCKET=telemetry
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_BRIDGE_USERNAME=iccms-bridge
MQTT_BRIDGE_PASSWORD=dev-bridge-pass
# Pipeline tests only: 60 = one config minute lasts one second (refused in production)
TELEMETRY_TIME_SCALE=1
TIERING_LOCAL_DIR=./.tiering
# Push (FCM service-account JSON, raw or base64) and SMTP: leave empty to skip those channels in dev
FIREBASE_CREDENTIALS_JSON=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
