# Copy to .env for local dev. Production values come from SSM (Section 17).
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=debug
DATABASE_URL=postgresql://iccms:iccms_dev@localhost:5432/iccms
ML_SERVICE_URL=http://localhost:8000
ML_INTERNAL_TOKEN=dev-internal-token
SMS_PROVIDER=console

# Supabase (D-21). Publishable values are fine here; the service role key is a secret (.env only).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SEND_SMS_HOOK_SECRET=
HTTPSMS_WEBHOOK_SECRET=

# Trace URL signing (SYN-09). Any random string of 32+ chars; must stay stable or old QR labels break.
TRACE_SIGNING_KEY=dev-trace-signing-key-change-me-0123456789

# Uploads (D-07). Leave S3_BUCKET empty to disable uploads in dev; S3_ENDPOINT only for MinIO/localstack.
AWS_REGION=ap-south-1
S3_BUCKET=
S3_ENDPOINT=
